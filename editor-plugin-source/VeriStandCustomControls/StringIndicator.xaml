<UserControl x:Class="NationalInstruments.VeriStand.GrpcPlugins.StringIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ni="http://schemas.ni.com/controls/2009/xaml/presentation"
             xmlns:local="clr-namespace:NationalInstruments.VeriStand.GrpcPlugins"
             mc:Ignorable="d" 
             d:DesignWidth="105" d:DesignHeight="50">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="92" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition MinHeight="22" Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <ni:StringControl  x:Name="DataIndicator"
                               Text="{Binding Data, UpdateSourceTrigger=PropertyChanged,  RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:StringIndicator}}}"
                               Grid.Row="0" MinWidth="90" MinHeight="20" IsReadOnly="True" Background="DarkGray"
                               Width="Auto" Height="Auto" Margin="2" Padding="2" 
                               TextWrapping="Wrap" SelectOnFocus="True" BorderThickness="1"/>
        <Label Grid.Row="1" Content="{Binding Status, UpdateSourceTrigger=PropertyChanged,  RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:StringIndicator}}}" />
    </Grid>
</UserControl>
