<UserControl x:Class="NationalInstruments.VeriStand.GrpcPlugins.MergeString"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ni="http://schemas.ni.com/controls/2009/xaml/presentation"
             xmlns:local="clr-namespace:NationalInstruments.VeriStand.GrpcPlugins"
             mc:Ignorable="d" 
             d:DesignHeight="160" d:DesignWidth="160">
    
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
            <Label Content="First Name" FontSize="10"></Label>
            <ni:StringControl  x:Name="FirstNameControl"
                               Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MergeString}}}"
                               MinWidth="90" MinHeight="20"
                               Width="Auto" Height="Auto" MaxWidth="1000" MaxHeight="100" Margin="2" Padding="2" 
                               TextWrapping="Wrap" SelectOnFocus="True" BorderThickness="1"/>
            <Label Content="Last Name" FontSize="10"></Label>
            <ni:StringControl  x:Name="LastNameControl"
                               Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MergeString}}}"
                               MinWidth="90" MinHeight="20"
                               Width="Auto" Height="Auto" MaxWidth="1000" MaxHeight="100" Margin="2" Padding="2" 
                               TextWrapping="Wrap" SelectOnFocus="True" BorderThickness="1"/>
            <Label Content="Full Name" FontSize="10"></Label>
            <ni:StringControl  x:Name="FullNameIndicator"
                               Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MergeString}}}"
                               MinWidth="150" MinHeight="20" IsReadOnly="True" Background="DarkGray"
                               Width="Auto" Height="Auto" MaxWidth="1000" MaxHeight="100" Margin="2" Padding="2" 
                               TextWrapping="Wrap" SelectOnFocus="True" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</UserControl>
